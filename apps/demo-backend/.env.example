# Selecciona el motor de almacenamiento del backend: local | turso
STORAGE_DRIVER=local

# Cuando STORAGE_DRIVER=local (libSQL en disco local)
LIBSQL_LOCAL_URL=file:./data/demo-backend.db

# Cuando STORAGE_DRIVER=turso (libSQL remoto en la nube de Turso)
# TURSO_DATABASE_URL=libsql://tu-base-tu-org.turso.io
# TURSO_AUTH_TOKEN=tu_token_de_turso

PORT=4000
HOST=0.0.0.0

