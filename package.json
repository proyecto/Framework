{
  "name": "app-framework-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify:arch": "node scripts/verify-architecture.mjs",
    "docs:generate": "node scripts/generate-api-docs.mjs",
    "docs:check": "node scripts/generate-api-docs.mjs --check",
    "create:app": "node scripts/create-app.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm verify:arch && pnpm docs:check",
    "dev:web": "pnpm --filter @framework/base-web dev",
    "dev:expo": "pnpm --filter @framework/base-expo start",
    "dev:expo:web": "pnpm --filter @framework/base-expo web",
    "upgrade:expo": "node scripts/upgrade-expo.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:auto": "node scripts/bump-version.mjs --auto"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}