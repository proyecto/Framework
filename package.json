{
  "name": "app-framework-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:backend": "pnpm --filter @framework/demo-backend dev",
    "dev:web": "pnpm --filter @framework/demo-web dev",
    "dev:expo": "pnpm --filter @framework/demo-expo start",
    "upgrade:expo": "node scripts/upgrade-expo.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

